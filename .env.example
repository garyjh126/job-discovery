# Copy to .env (gitignored) and fill in. docker compose reads it automatically.

# Host folder the daily note is written to, e.g. an Obsidian vault's inbox. Required.
VAULT_INBOX="/path/to/vault/00 Inbox"

# Absolute path of this folder on the host, so the note can link to data/roles.html.
HOST_DIR="/path/to/job-discovery"

# Timezone of the container, and the local hour after which the daily sweep runs.
TZ=Europe/London
RUN_HOUR=8
